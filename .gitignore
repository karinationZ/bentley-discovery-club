# ── Secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# ── OS / IDE ──────────────────────────────────────────────
.DS_Store
.idea/
*.swp

# ── Generated media (lives on disk, NOT in git) ───────────
# This is a media-production repo (~4.5 GB of renders). Binaries are
# intentionally untracked; use external storage / git-LFS if you ever
# need them versioned. Code, docs (.md) and configs (.json) ARE tracked.
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tiff
*.psd
*.mp4.part

# Backups — incl. media backups like *.mp4.bak / *.png.bak (matched by *.mp4 etc. only at end-of-name)
*.bak
*.orig

# ── Claude Code ───────────────────────────────────────────
# Per-user local settings (permission allowlists); the shared .claude/settings.json
# and .claude/skills/ ARE tracked. Local overrides stay on this machine.
.claude/settings.local.json
