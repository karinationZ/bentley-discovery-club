# Copy to .env and fill in real values. NEVER commit .env (it is git-ignored).
# Bentley's Discovery Club — production API keys.

# ElevenLabs — voices (Bentley/Pip/Narrator), music, SFX
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# fal.ai — Kling video, Nano-Banana keyframes, hosted storage
FAL_KEY=your-fal-key-here

# kie.ai — cheaper Kling 2.6 / Nano-Banana / Kling-Avatar alternative
KIE_KEY=your-kie-key-here

# sync.so — lip-sync (if used)
SYNC_API_KEY=your-sync-key-here
