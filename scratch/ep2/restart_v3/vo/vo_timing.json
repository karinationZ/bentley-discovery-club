{
  "source_cue_sheet": "/project/docs/series/season_1/ep2/EP2_v3_PRODUCTION_CUE_SHEET.md",
  "source_shotlist": "/project/episodes/ep2/shotlists/ep2_v3_character_driven.json",
  "line_count": 88,
  "label_audio": [
    {
      "label": "P1_B01",
      "speaker": "Bentley",
      "text": "Helloooo, little rock. You look like you need a boop.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B01.mp3",
      "duration": 4.56
    },
    {
      "label": "P1_B02",
      "speaker": "Bentley",
      "text": "You winked.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B02.mp3",
      "duration": 1.12
    },
    {
      "label": "P1_I01",
      "speaker": "Indi",
      "text": "Rocks are very good winkers.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_I01.mp3",
      "duration": 1.76
    },
    {
      "label": "P1_B03",
      "speaker": "Bentley",
      "text": "You are not a rock.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B03.mp3",
      "duration": 1.6
    },
    {
      "label": "P1_I02",
      "speaker": "Indi",
      "text": "I am when I want to be.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_I02.mp3",
      "duration": 2.24
    },
    {
      "label": "P1_B04",
      "speaker": "Bentley",
      "text": "I'm Bentley.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B04.mp3",
      "duration": 1.04
    },
    {
      "label": "P1_I03",
      "speaker": "Indi",
      "text": "And I am Indi, impossible to find.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_I03.mp3",
      "duration": 3.44
    },
    {
      "label": "P1_B05",
      "speaker": "Bentley",
      "text": "I found you.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B05.mp3",
      "duration": 1.12
    },
    {
      "label": "P1_I04",
      "speaker": "Indi",
      "text": "You found one eyeball. That barely counts.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_I04.mp3",
      "duration": 3.2
    },
    {
      "label": "P1_B06",
      "speaker": "Bentley",
      "text": "There are rules?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B06.mp3",
      "duration": 1.36
    },
    {
      "label": "P1_I05",
      "speaker": "Indi",
      "text": "Rule one: no booping the champion.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_I05.mp3",
      "duration": 3.2
    },
    {
      "label": "P1_B07",
      "speaker": "Bentley",
      "text": "Champion of what?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_B07.mp3",
      "duration": 1.44
    },
    {
      "label": "P1_I06",
      "speaker": "Indi",
      "text": "Hide-and-seek.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P1_I06.mp3",
      "duration": 0.96
    },
    {
      "label": "P2_I01",
      "speaker": "Indi",
      "text": "Watch closely, puppy detective.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_I01.mp3",
      "duration": 1.92
    },
    {
      "label": "P2_B01",
      "speaker": "Bentley",
      "text": "I'm watching with my whole face.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_B01.mp3",
      "duration": 2.32
    },
    {
      "label": "P2_B02",
      "speaker": "Bentley",
      "text": "Your skin did a costume change!",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_B02.mp3",
      "duration": 2.56
    },
    {
      "label": "P2_I02",
      "speaker": "Indi",
      "text": "Color and texture. Very fancy. Very useful.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_I02.mp3",
      "duration": 3.76
    },
    {
      "label": "P2_I03",
      "speaker": "Indi",
      "text": "No Indi here. Only extremely normal rock.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_I03.mp3",
      "duration": 3.2
    },
    {
      "label": "P2_B03",
      "speaker": "Bentley",
      "text": "This rock sounds smug.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_B03.mp3",
      "duration": 1.76
    },
    {
      "label": "P2_I04",
      "speaker": "Indi",
      "text": "That is because this rock is winning.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_I04.mp3",
      "duration": 2.56
    },
    {
      "label": "P2_N01",
      "speaker": "Narrator",
      "text": "An octopus can change color and texture in a blink.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_N01.mp3",
      "duration": 4.56
    },
    {
      "label": "P2_B04",
      "speaker": "Bentley",
      "text": "I was looking at you, and then you became geology.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_B04.mp3",
      "duration": 3.36
    },
    {
      "label": "P2_B05",
      "speaker": "Bentley",
      "text": "But how do I find you?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_B05.mp3",
      "duration": 1.92
    },
    {
      "label": "P2_I05",
      "speaker": "Indi",
      "text": "A trail, if you listen.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_I05.mp3",
      "duration": 1.44
    },
    {
      "label": "P2_B06",
      "speaker": "Bentley",
      "text": "You are tiny trouble.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_B06.mp3",
      "duration": 1.76
    },
    {
      "label": "P2_I06",
      "speaker": "Indi",
      "text": "Thank you.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P2_I06.mp3",
      "duration": 0.88
    },
    {
      "label": "P3_B01",
      "speaker": "Bentley",
      "text": "So you hide because it is fun?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_B01.mp3",
      "duration": 2.32
    },
    {
      "label": "P3_I01",
      "speaker": "Indi",
      "text": "Fun. Clever. Dramatic. Also because some neighbors have very big mouths.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_I01.mp3",
      "duration": 7.04
    },
    {
      "label": "P3_B02",
      "speaker": "Bentley",
      "text": "Your spots just went flashlight.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_B02.mp3",
      "duration": 2.32
    },
    {
      "label": "P3_I02",
      "speaker": "Indi",
      "text": "That means: do not be crunchy.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_I02.mp3",
      "duration": 2.32
    },
    {
      "label": "P3_B03",
      "speaker": "Bentley",
      "text": "I'll chase it away!",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_B03.mp3",
      "duration": 1.36
    },
    {
      "label": "P3_I03",
      "speaker": "Indi",
      "text": "Please do not chase anything with that many teeth.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_I03.mp3",
      "duration": 3.28
    },
    {
      "label": "P3_B04",
      "speaker": "Bentley",
      "text": "Right. No chasing teeth.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_B04.mp3",
      "duration": 2.0
    },
    {
      "label": "P3_N01",
      "speaker": "Narrator",
      "text": "That is a moray eel. Not a villain, just a hungry neighbor. For a small octopus, hiding is smart.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_N01.mp3",
      "duration": 8.88
    },
    {
      "label": "P3_B05",
      "speaker": "Bentley",
      "text": "So hide-and-seek is survival.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_B05.mp3",
      "duration": 2.64
    },
    {
      "label": "P3_I04",
      "speaker": "Indi",
      "text": "And style.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P3_I04.mp3",
      "duration": 1.04
    },
    {
      "label": "P4_I01",
      "speaker": "Indi",
      "text": "What is that shiny paw?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I01.mp3",
      "duration": 1.52
    },
    {
      "label": "P4_B01",
      "speaker": "Bentley",
      "text": "My Listening Tag. It glows when I stay still.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B01.mp3",
      "duration": 4.48
    },
    {
      "label": "P4_I02",
      "speaker": "Indi",
      "text": "Impressive.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I02.mp3",
      "duration": 0.96
    },
    {
      "label": "P4_B02",
      "speaker": "Bentley",
      "text": "Thank you.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B02.mp3",
      "duration": 0.96
    },
    {
      "label": "P4_I03",
      "speaker": "Indi",
      "text": "It tastes like sunshine and wet dog.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I03.mp3",
      "duration": 2.64
    },
    {
      "label": "P4_B03",
      "speaker": "Bentley",
      "text": "That is my personal brand.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B03.mp3",
      "duration": 2.56
    },
    {
      "label": "P4_N01",
      "speaker": "Narrator",
      "text": "Octopus arms taste and feel. Indi was reading Bentley.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_N01.mp3",
      "duration": 5.36
    },
    {
      "label": "P4_B04",
      "speaker": "Bentley",
      "text": "See? I can really stop and look.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B04.mp3",
      "duration": 2.56
    },
    {
      "label": "P4_I04",
      "speaker": "Indi",
      "text": "You really can stop.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I04.mp3",
      "duration": 1.52
    },
    {
      "label": "P4_B05",
      "speaker": "Bentley",
      "text": "Only for important things.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B05.mp3",
      "duration": 2.08
    },
    {
      "label": "P4_I05",
      "speaker": "Indi",
      "text": "Am I important?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I05.mp3",
      "duration": 1.36
    },
    {
      "label": "P4_B06",
      "speaker": "Bentley",
      "text": "Extremely.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B06.mp3",
      "duration": 1.52
    },
    {
      "label": "P4_I06",
      "speaker": "Indi",
      "text": "Then I shall become extremely Bentley.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I06.mp3",
      "duration": 2.88
    },
    {
      "label": "P4_B07",
      "speaker": "Bentley",
      "text": "You did me! You're a teeny-tiny tidepool Bentley!",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B07.mp3",
      "duration": 4.0
    },
    {
      "label": "P4_I07",
      "speaker": "Indi",
      "text": "Do I look brave?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_I07.mp3",
      "duration": 1.04
    },
    {
      "label": "P4_B08",
      "speaker": "Bentley",
      "text": "You look like trouble wearing my outfit.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P4_B08.mp3",
      "duration": 2.88
    },
    {
      "label": "P5_I01",
      "speaker": "Indi",
      "text": "Big mouth. Back again.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I01.mp3",
      "duration": 2.16
    },
    {
      "label": "P5_B01",
      "speaker": "Bentley",
      "text": "No chasing teeth.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B01.mp3",
      "duration": 1.44
    },
    {
      "label": "P5_I02",
      "speaker": "Indi",
      "text": "Too tight!",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I02.mp3",
      "duration": 1.84
    },
    {
      "label": "P5_I03",
      "speaker": "Indi",
      "text": "No yanking. I am soft parts!",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I03.mp3",
      "duration": 2.64
    },
    {
      "label": "P5_B02",
      "speaker": "Bentley",
      "text": "Right. Soft parts. No yanking.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B02.mp3",
      "duration": 2.96
    },
    {
      "label": "P5_B03",
      "speaker": "Bentley",
      "text": "Champion, what does a champion do?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B03.mp3",
      "duration": 2.16
    },
    {
      "label": "P5_I04",
      "speaker": "Indi",
      "text": "Hide?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I04.mp3",
      "duration": 1.52
    },
    {
      "label": "P5_B04",
      "speaker": "Bentley",
      "text": "And?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B04.mp3",
      "duration": 0.88
    },
    {
      "label": "P5_I05",
      "speaker": "Indi",
      "text": "Squeeze.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I05.mp3",
      "duration": 0.88
    },
    {
      "label": "P5_B05",
      "speaker": "Bentley",
      "text": "Squeeze like fancy soup.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B05.mp3",
      "duration": 2.0
    },
    {
      "label": "P5_I06",
      "speaker": "Indi",
      "text": "That is not science wording.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I06.mp3",
      "duration": 2.0
    },
    {
      "label": "P5_B06",
      "speaker": "Bentley",
      "text": "No bones. Slow breath. Soft body.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B06.mp3",
      "duration": 4.88
    },
    {
      "label": "P5_B07",
      "speaker": "Bentley",
      "text": "You did it! You fancy-souped!",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B07.mp3",
      "duration": 2.4
    },
    {
      "label": "P5_I07",
      "speaker": "Indi",
      "text": "Escape artist.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I07.mp3",
      "duration": 1.12
    },
    {
      "label": "P5_N01",
      "speaker": "Narrator",
      "text": "If a gap is bigger than her tiny beak, an octopus can pour through.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_N01.mp3",
      "duration": 5.36
    },
    {
      "label": "P5_B08",
      "speaker": "Bentley",
      "text": "I wanted to help by pulling.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_B08.mp3",
      "duration": 2.08
    },
    {
      "label": "P5_I08",
      "speaker": "Indi",
      "text": "You helped by listening.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P5_I08.mp3",
      "duration": 2.0
    },
    {
      "label": "P6_B01",
      "speaker": "Bentley",
      "text": "You changed color, tasted my tag, and turned into soup.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B01.mp3",
      "duration": 4.0
    },
    {
      "label": "P6_I01",
      "speaker": "Indi",
      "text": "I also have three hearts.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I01.mp3",
      "duration": 1.92
    },
    {
      "label": "P6_B02",
      "speaker": "Bentley",
      "text": "Three? My one heart already gets busy.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B02.mp3",
      "duration": 2.96
    },
    {
      "label": "P6_I02",
      "speaker": "Indi",
      "text": "Two help my gills. One sends blue blood everywhere.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I02.mp3",
      "duration": 3.68
    },
    {
      "label": "P6_B03",
      "speaker": "Bentley",
      "text": "Blue blood?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B03.mp3",
      "duration": 1.12
    },
    {
      "label": "P6_I03",
      "speaker": "Indi",
      "text": "Very fashionable.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I03.mp3",
      "duration": 1.36
    },
    {
      "label": "P6_N01",
      "speaker": "Narrator",
      "text": "Three hearts. Blue blood. Built for hiding, squeezing, and surprising puppies.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_N01.mp3",
      "duration": 6.72
    },
    {
      "label": "P6_B04",
      "speaker": "Bentley",
      "text": "I'm glad I found your eyeball.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B04.mp3",
      "duration": 2.0
    },
    {
      "label": "P6_I04",
      "speaker": "Indi",
      "text": "I am glad you stopped chasing it.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I04.mp3",
      "duration": 1.84
    },
    {
      "label": "P6_B05",
      "speaker": "Bentley",
      "text": "Another clue?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B05.mp3",
      "duration": 1.36
    },
    {
      "label": "P6_I05",
      "speaker": "Indi",
      "text": "The next mystery is not in the water.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I05.mp3",
      "duration": 2.64
    },
    {
      "label": "P6_B06",
      "speaker": "Bentley",
      "text": "That crumb has legs.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B06.mp3",
      "duration": 1.76
    },
    {
      "label": "P6_I06",
      "speaker": "Indi",
      "text": "Lots of them.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I06.mp3",
      "duration": 1.52
    },
    {
      "label": "P6_B07",
      "speaker": "Bentley",
      "text": "Where are they going?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B07.mp3",
      "duration": 1.36
    },
    {
      "label": "P6_I07",
      "speaker": "Indi",
      "text": "Underground.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I07.mp3",
      "duration": 0.96
    },
    {
      "label": "P6_B08",
      "speaker": "Bentley",
      "text": "Do underground crumbs need boops?",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B08.mp3",
      "duration": 2.8
    },
    {
      "label": "P6_I08",
      "speaker": "Indi",
      "text": "Only after we listen.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_I08.mp3",
      "duration": 1.76
    },
    {
      "label": "P6_B09",
      "speaker": "Bentley",
      "text": "Stop. Look. Listen.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_B09.mp3",
      "duration": 2.641
    },
    {
      "label": "P6_N02",
      "speaker": "Narrator",
      "text": "And just like that, the tidepool handed Bentley one more secret.",
      "path": "/project/scratch/ep2/restart_v3/vo/labels/P6_N02.mp3",
      "duration": 4.48
    }
  ],
  "readthrough": {
    "path": "/project/scratch/ep2/restart_v3/vo/EP2_v3_VO_READTHROUGH.mp3",
